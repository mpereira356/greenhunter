[Unit]
Description=GreenHunter - coleta prospectiva oficial e prewarm diário
After=network-online.target greenhunter.service

[Service]
Type=oneshot
User=viny
WorkingDirectory=/home/viny/greenhunter
EnvironmentFile=/home/viny/greenhunter/.env
Environment=DISABLE_WORKER=1
ExecStart=/home/viny/greenhunter/venv/bin/python /home/viny/greenhunter/prospective_daily.py
TimeoutStartSec=infinity
Nice=10
IOSchedulingClass=idle
