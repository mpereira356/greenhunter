# ==============================
# CONFIGURAÇÃO GERAL
# ==============================
SECRET_KEY=change-me
DATABASE_URL=
EXPORT_DIR=data/exports

# ==============================
# WORKER / LOOP
# ==============================
DISABLE_WORKER=0
WORKER_INTERVAL=1
ALERTS_POLL_INTERVAL=1
WORKER_GAME_DELAY=0.1
FORCE_SECOND_HALF_FROM_FIRST_HALF=1
FETCH_STATS_ATTEMPTS=2
FETCH_STATS_DELAY=0.3
ALERT_FETCH_STATS_ATTEMPTS=2
ALERT_FETCH_STATS_DELAY=0.2
FINALIZE_POLL_INTERVAL=60
FOLLOW_SETTLED_WINDOW_MINUTES=20
FINALIZE_LOOKBACK_HOURS=12

# ==============================
# BETSAPI / CLOUDFLARE
# ==============================
BETSAPI_CF_MODE=manual
BETSAPI_CF_WAIT_SECONDS=180
BETSAPI_CF_COOLDOWN_SECONDS=60

# ==============================
# BROWSER (VPS SAFE CONFIG)
# ==============================

# Diretório de perfil do navegador
BETSAPI_BROWSER_PROFILE_DIR=data/browser_profile

# 1 = headless (SEM interface gráfica)
# 0 = gráfico (com interface gráfica)
BETSAPI_BROWSER_HEADLESS=0

# DISPLAY DA SESSÃO GRÁFICA (RDP costuma ser :10.0)
BETSAPI_DISPLAY=:10.0
IA_SHADOW_2H_MIN_GREEN_RATE=55
IA_SHADOW_2H_MIN_SAMPLES=120
